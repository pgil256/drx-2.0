# Shell scripts must stay LF: they are executed on Linux (CI runners, WSL, the
# Raspberry Pi) even when the repo is checked out on Windows with autocrlf.
*.sh text eol=lf
*.desktop text eol=lf
# Educational videos live in Git LFS (run `git lfs pull` after cloning).
# The other eight joined the HCT/P clip on 2026-11-05; their older commits
# keep plain blobs, since history was not rewritten.
runtime/raspberry-pi/main/ui/media/videos/*.mp4 filter=lfs diff=lfs merge=lfs -text
