# Dedicated dashboard registration for simulated hardware. Never reuse a Pi token.
# Copy to devices/development/cloud-simulator/raspberry-pi/cloud.env.
KNEESPA_CLOUD_URL=https://kneespa-cloud.onrender.com
KNEESPA_DEVICE_ID=drx-desktop-sim-01
KNEESPA_DEVICE_TOKEN=
# Optional override for the registration QR; defaults to the cloud URL + /patients/new.
KNEESPA_PATIENT_PORTAL_URL=
