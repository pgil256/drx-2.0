  <property name="styleSheet">
   <string notr="true">/* General Styles */
* {
    background-color: white;
    font-family: 'Arial', sans-serif;
    font-size: 14px;
}

/* Main Window and Central Widget */
QWidget#MainWindow, QWidget#central_widget {
    background-color: white;
}

/* Frame Styles */
QFrame#frameTop, QFrame#frame, QGroupBox#frameBottom {
    background-color: rgb(30, 30, 30);
    color: white;
    border: none;
    text-align: center;
    text-decoration: none; /* This is valid */
    font-size: 14px;
    font-weight: bold;
}

QFrame#frame_3 {
    border:none;
}

/* Layout Styles */
QVBoxLayout#verticalLayout_3 {
    background-color: white;
    border: 2px solid red;
    border-radius: 45px;
    padding: 14px;
}

QGridLayout#gridLayout_2 {
    border: none;
    padding: 20px;
}

QHBoxLayout#horizontalLayout_19 {
    background-color: rgb(200, 0, 0);
    color: white;
    border: none;
    font-weight: bold;      
    font-size: 32px;
    border-radius: 12px;
}

QVBoxLayout#verticalLayout_20, QVBoxLayout#verticalLayout_21 {
    border-bottom: 2px solid #bdc3c7;
    padding: 2px;
    background-color: #ecf0f1;
    border: 2px solid #bdc3c7;
    border-radius: 4px;
    font-size: 18px;
}

/* Button Styles */
QPushButton#push_button_start {
    background-color: rgb(0, 200, 0);
    color: white;
    border: none;
    font-weight: bold;       
    font-size: 32px;
    border-radius: 12px;
}

QPushButton#login_button, QPushButton#setup_button, QPushButton#protocols_button, QPushButton#help_button {
    background-color: rgb(30, 30, 30);
    color: white;
    border: none;
    text-align: center;
    text-decoration: none; /* This is valid */
    font-size: 22px;
    font-weight: bold;
    margin: 4px 2px;
    border-radius: 12px;
}

QPushButton#reset_arduino_setup_button, QPushButton#axial_flexion_position_go_button, QPushButton#axial_flexion_position_stop_button {
    outline: 0;
    border: 2px solid rgb(0,57,138);
    font-size: 18px; /* Specific font-size */
    border-radius: 8px;
    background-color: #3498db;
    color: white;
    font-weight: bold;
}

/* General Button Pseudo-States (applied if specific button doesn't override) */
QPushButton:hover:!pressed {
    background-color: #54d777; /* Generic hover - might be overridden by specific hovers below */
}

QPushButton:hover:pressed {
    background-color: yellow; /* Generic pressed - might be overridden by specific press below */
    border: 2px solid red;
}

QPushButton:disabled {
    background-color: purple; /* Generic disabled - might conflict/be overridden by specific disabled below */
}

QPushButton:!enabled {
    background-color: white;
    color: black;
}

QPushButton:enabled {
    /* Be careful: This might override specific button background/color when enabled */
    /* Consider removing if it conflicts with desired specific button styles */
    /* background-color: grey; */
    /* color: white; */
}

/* Request Status Change Button Specific Styles */
QPushButton#request_status_change {
    background-color: #3498db; /* Bright blue - primary action */
    color: white;
    border: none;
    padding: 12px 20px;
    font-size: 16px;
    font-weight: bold;
    border-radius: 8px;
    min-width: 250px;
    min-height: 50px;
    text-align: center;
    margin: 5px;
}

QPushButton#request_status_change:hover {
    background-color: #2980b9; /* Darker blue on hover */
}

QPushButton#request_status_change:pressed {
    background-color: #2472a4; /* Even darker when pressed */
}

/* Request Assistance Button Specific Styles (Note: Original had duplicate comment but correct selector) */
QPushButton#request_assistance {
    background-color: #3498db; /* Bright blue - primary action */
    color: white;
    border: none;
    padding: 12px 20px;
    font-size: 16px;
    font-weight: bold;
    border-radius: 8px;
    min-width: 250px;
    min-height: 50px;
    text-align: center;
    margin: 5px;
}

/* NOTE: request_pin_reset seems to be missing its base style, only hover/pressed are defined? */
QPushButton#request_pin_reset:hover {
    background-color: #2472a4; /* Even darker when pressed */
}

QPushButton#request_pin_reset:pressed {
    background-color: #219a52; /* Even darker when pressed */
}

/* Request Assistance Button (assuming this is the correct ID for the button mentioned in profile page) */
QPushButton#request_assistance_button {
    background-color: rgb(0, 170, 255); /* Original comment said red, but CSS is blue */
    color: white;
    border: none;
    padding: 12px 20px;
    font-size: 20px;
    font-weight: bold;
    border-radius: 8px;
    min-width: 250px;
    min-height: 50px;
    text-align: center;
    margin: 5px;
}

/* Exit App Button Specific Styles */
QPushButton#exit_app_button {
    background-color: #e74c3c; /* Red - warning/danger action */
    color: white;
    border: none;
    padding: 12px 20px;
    font-size: 20px;
    font-weight: bold;
    border-radius: 8px;
    min-width: 250px;
    min-height: 50px;
    text-align: center;
    margin: 5px;
}

QPushButton#exit_app_button:hover {
    background-color: #c0392b; /* Darker red on hover */
}

QPushButton#exit_app_button:pressed {
    background-color: #a93226; /* Even darker when pressed */
}

/* Disabled State for Specific Buttons */
QPushButton#request_status_change:disabled,
QPushButton#request_pin_reset:disabled, /* Assuming request_pin_reset is a QPushButton */
QPushButton#exit_app_button:disabled {
    background-color: #bdc3c7; /* Gray when disabled */
    color: #7f8c8d;
    cursor: not-allowed; /* Good practice for disabled buttons */
}

/* Focus State for Specific Buttons */
QPushButton#request_status_change:focus,
QPushButton#request_pin_reset:focus, /* Assuming request_pin_reset is a QPushButton */
QPushButton#exit_app_button:focus {
    outline: none; /* Removes default focus outline */
}


/* Label Styles */
QLabel#video_player_button {
    background-color: white;
    border: 2px solid red;
    border-radius: 45px;
    padding: 14px;
}

QLabel#measuredLocationlabel_4, QLabel#measuredWeightlabel_4 {
    font-size: 16px;
    padding: 2px;
}

QLabel#emergency_stop_setup_label {
    background-color: rgb(200, 0, 0);
    color: white;
    border: none;
    font-weight: bold;         
    font-size:30px;
    border-radius: 12px;
}

/* Group Box Styles */
QGroupBox {
    font-weight: bold;
    border: 0px solid silver; /* Effectively no border */
    border-radius: 6px;
    margin-top: 0px; /* Adjust if needed, 0px is default */
}

/* Enhanced Slider Styles (Using these as the primary slider styles now) */
QSlider::groove:horizontal {
    border: 3px solid #bdc3c7;
    height: 6px;
    background: #ecf0f1;
    border-radius: 4px;
}

QSlider::groove:horizontal:hover {
    background-color: #d6eaf8;
}

QSlider::handle:horizontal {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0,
                                      stop:0 rgba(0, 50, 145, 255),
                                      stop:1 rgba(255, 255, 255, 255));
    border: 3px solid #2c3e50;
    width: 36px;
    height: 36px;
    margin: -15px 0;
    border-radius: 18px;
}

QSlider::handle:horizontal:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0,
                                      stop:0 rgba(0, 70, 175, 255),
                                      stop:1 rgba(220, 235, 255, 255));
}

QSlider::sub-page:horizontal {
    background: #3498db;
    border: 3px solid #2980b9;
    border-radius: 4px;
}

/* Apply padding to specific sliders (and potentially misidentified SpinBoxes) */



QGroupBox::title {
    subcontrol-origin: margin;
    left: 7px;
    padding: 0px 5px 0px 5px;
}

/* Transparent Backgrounds */
QGroupBox#groupBox_31, QVBoxLayout#verticalLayout_5, QLabel#axialFlexionPositionSliderlabel_3 {
    background: transparent;
}

/* Top Navigation Styles */
QLabel#top_nav_logo, QLabel#top_nav_brand_label, QLabel#username_nav {
    background-color: rgb(30, 30, 30);
    color: white;
    border: none;
    text-align: center;
    text-decoration: none; /* Valid for labels */
    margin: 4px 30px;
}

QLabel#top_nav_brand_label {
    font-size: 40px;
    font-weight: bold;
}

QLabel#username_nav {
    font-size: 20px;
    font-weight: bold;
    border-radius: 12px;
}

/* Profile Button (assuming QLabel is clickable via event filter/override) */
QLabel#profile_button {
    background-color: white;
    border: 2px solid black;
    margin: 0px 30px 0px 20px;
    border-radius: 40px;
    padding: 12px;
}

/* Page Styles */
QWidget#page_setup {
    font-size: 16px;
    padding: 2px;
}

/* Styling for Tab Widget and its content pages */
/* Apply to the tab widget itself and specific named tab pages */
QTabWidget#DRx_tabs, QWidget#preset_protocols_tab, QWidget#page_main /* Added page_main based on structure */ {
    background-color: white;
    border: none;
    font-size: 22px; /* Note: Affects content font unless overridden */
}

/* Preset Protocols Tab Specific Styles */
QVBoxLayout#verticalLayout_4, QVBoxLayout#verticalLayout_6 {
    border: none;
    padding: 15px;
    margin-top: 10px;
}

QGroupBox#groupBox_3, QGroupBox#groupBox_14, QGroupBox#groupBox_15 {
    padding: 10px 15px;
    margin-top: 10px;
}

QHBoxLayout#horizontalLayout_3, QHBoxLayout#horizontalLayout_11, QHBoxLayout#horizontalLayout_12 {
    font-size: 32px; /* Affects widgets within unless they override */
    font-weight: bold;
    margin: 5px 0px;
    border-bottom: 2px solid #bdc3c7;
    padding: 2px;
    background-color: #ecf0f1;
    border: 2px solid #bdc3c7;
    border-radius: 4px;
}

QLabel#label_protocol_image {
    border:2px solid black;
}

QLabel#label_5, QLabel#backward_button_protocol_image, QLabel#forward_button_protocol_image,
QLabel#label_12 {
    font-size: 24px; /* Overrides layout font */
    font-weight: bold;
}

QLabel#time_label, QLabel#max_pressure_label, QLabel#max_left_label, QLabel#max_right_label {
    color: #2c3e50;
    font: bold 20px 'Arial', sans-serif;
    padding: 5px 0px;
}

/* SpinBox Styles */
QSpinBox#time_edit {
    background-color: white;
    border: 2px solid rgb(52, 152, 219);
    border-radius: 4px;
    padding: 5px;
    min-width: 100px;
    min-height: 30px;
    font: 18px 'Arial', sans-serif;
    color: #2c3e50;
}

QSpinBox#time_edit::up-button, QSpinBox#time_edit::down-button {
    width: 40px;
}


QSpinBox#max_pressure_edit, QSpinBox#max_left_edit, QSpinBox#max_right_edit {
    background-color: white;
    border: 2px solid rgb(52, 152, 219);
    border-radius: 4px;
    padding: 5px;
    min-width: 80px;
    min-height: 30px;
    font: 18px 'Arial', sans-serif; 
    color: #2c3e50;
}

QSpinBox#max_pressure_edit::up-button, QSpinBox#max_left_edit::up-button, QSpinBox#max_right_edit::up-button,
QSpinBox#max_pressure_edit::down-button, QSpinBox#max_left_edit::down-button, QSpinBox#max_right_edit::down-button {
    width: 40px;
}



QCheckBox#checkbox_use_pulse, QCheckBox#checkbox_show_pressure, QCheckBox#checkbox_show_timer {
    font: bold 18px 'Arial', sans-serif;
    color: #2c3e50;
    spacing: 8px;
}


QCheckBox#checkbox_use_pulse::indicator, QCheckBox#checkbox_show_pressure::indicator, QCheckBox#checkbox_show_timer::indicator {
    width: 26px;
    height: 26px;
    border: 3px solid rgb(52, 152, 219);
    border-radius: 4px;
    background-color: white;
}


QCheckBox#checkbox_use_pulse::indicator:checked, QCheckBox#checkbox_show_pressure::indicator:checked, QCheckBox#checkbox_show_timer::indicator:checked {
    background-color: rgb(52, 152, 219);
}


QGroupBox#groupBox_15 {
    margin-top: 10px;
    padding-top: 10px;
}

/* Input Field Styles */
QLineEdit#protocol_number_field, QLineEdit#pressure_field {
    font-size: 22px;
    background-color: white;
    border: 2px solid #bdc3c7;
    border-radius: 4px;
    padding: 4px;
    color: #34495e;
    min-width: 60px;
}

/* General CheckBox Styles (Apply if specific checkbox doesn't override) */
QCheckBox {
    spacing: 10px;
    font-size: 24px;
    font-weight: bold;
}

QCheckBox::indicator {
    width: 24px;
    height: 24px;
}

/* Profile Page Styles */
QWidget#profile_page, QGroupBox#groupBox, QGroupBox#groupBox_4,
QGroupBox#groupBox_5, QGroupBox#groupBox_7, QGroupBox#groupBox_13, QGroupBox#groupBox_12, QGroupBox#groupBox_10 {
    border: none; /* Ensure group boxes here don't inherit default border if any */
}

QGroupBox#groupBox_4 { /* This specific group box gets a border and gradient */
    font-size: 14px; /* Overrides default */
    font-weight: bold;
    color: #333333;
    border: 2px solid #3498db;
    border-radius: 8px;
    margin-top: 1ex; /* 1ex is roughly height of 'x' character */
    padding: 0px 2px;
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #f0f9ff, stop: 1 #e6f3ff);
}

QLabel#label_4, QLabel#username_label,
QLabel#email_label, QLabel#status_label {
    border: none;
    padding: 0 5px;
    color: #2c3e50;
    font-size: 24px;
    font-weight: bold;
}

/* Assuming pushButton exists on profile page? */
QPushButton#pushButton {
    background-color: #3498db;
    color: white;
    border: none;
    font-size: 22px;
    padding: 3px 9px;
    border-radius: 4px;
    font-weight: bold;
}

/* Help Page Styles */
QWidget#help_page, QGroupBox#groupBox_11, QGroupBox#groupBox_18 {
    color: #333333;
    background-color: #ffffff;
    border: none;
    padding: 10px;
}

QLabel#label_14 { /* Help page title label */
    border: none;
    padding: 0 10px;
    color: #3498db;
    font-weight: bold;
    font-size: 32px;
}

QPlainTextEdit#help_text_edit {
    border: none;
    font-size: 24px;
    padding: 30px;
    color: black;
    background-color: white;
    border-left: 4px solid #3498db;
    margin-left: 20px;
}

/* Additional Button Styles (Measure buttons) */
QPushButton#measure_weight_button, QPushButton#measure_location_button {
    border-bottom: 2px solid #bdc3c7;
    padding: 2px;
    background-color: #ecf0f1;
    border: 2px solid #bdc3c7; /* Overrides bottom border thickness */
    border-radius: 4px;
    font-size: 18px;
}

/* Additional Button Styles (Go/Stop buttons in Setup) */
QPushButton#axial_flexion_pressure_go_button, QPushButton#axial_flexion_pressure_stop_button,
QPushButton#lateral_flexion_position_go_button, QPushButton#lateral_flexion_position_stop_button,
QPushButton#horizontal_flexion_position_go_button, QPushButton#horizontal_flexion_position_stop_button {
    outline: 0;
    border: 2px solid rgb(0,57,138);
    font-size: 18px; /* Specific font-size */
    border-radius: 8px;
    background-color: #3498db;
    color: white;
    font-weight: bold;
}
/* Label Styles for Flexion Readouts */
QLabel#lateral_flexion_position_label, QLabel#axial_flexion_position_label, QLabel#axial_flexion_pressure_label, QLabel#axial_flexion_position_label_2,
QLabel#lateral_flexion_position_label, QLabel#horizontal_flexion_position_label {
    font-size: 22px;
    background-color: white;
    border: 2px solid #bdc3c7;
    border-radius: 4px;
    padding: 4px;
    color: #34495e;
    min-width: 60px; /* Ensures a minimum width */
}

/* Table Widget Styles */
QTableWidget#patient_table_widget, QTableWidget#patient_table_widget_2 {
    background-color: #ffffff;
    padding: 10px 30px 0px 30px;
    alternate-background-color: #f7f7f7; /* For alternating row colors */
    border-radius: 4px;
    gridline-color: #e0e0e0; /* Color of the grid lines */
}

QTableWidget::item {
    /* width: 200px; */ /* Applying fixed width to items might not be best, let header control */
    padding: 5px; /* Add some padding within cells */
}

QTableWidget::item:selected {
    background-color: #e6f3ff; /* Light blue for selected items */
    color: #000000; /* Black text when selected */
}

QHeaderView::section {
    background-color: rgb(85, 170, 255); /* Blue header background */
    color: white;
    padding: 10px;
    /* width: 300px; */ /* Let the view manage size or set stretch modes */
    border: 2px solid #e0e0e0; /* Light border for header sections */
    font-weight: bold;
}

QTabBar::tab {
    /* Size */
    height: 20px;
    min-width: 235px; /* Use min-width for flexibility, adjust as needed */
    max-width: 250px; /* Optional max width */

    /* Spacing */
    padding: 5px 15px; /* Vertical and horizontal padding */
    margin-right: 2px; /* Space between tabs */

    /* Appearance */
    background-color: #E0E0E0; /* Light grey background */
    color: #333333; /* Dark text */
	font-weight: bold;
    border: 2px solid #B0B0B0; /* Border color */
    border-bottom: none; /* Remove bottom border to connect with pane below */
    border-top-left-radius: 6px; /* Rounded top-left corner */
    border-top-right-radius: 6px; /* Rounded top-right corner */

    /* Font (Optional) */
    /* font-weight: bold; */
    /* font-size: 14px; */
}

QTabBar::tab:!selected {
    /* Slightly recess non-selected tabs */
    margin-top: 3px;
    background-color: #F0F0F0; /* Slightly lighter/different grey */
     color: #555555;
     border-color: #C0C0C0;
}

QTabBar::tab:hover:!selected {
    background-color: #E8E8E8; /* Slightly darker background on hover */
    border-color: #A0A0A0;
}

QTabBar::tab:selected {
    background-color: #FFFFFF; /* White/Bright background for selected */
    color: #000000; /* Black text */
    /* margin-top: 0; */ /* Ensure it's aligned if others have margin-top */
    border-color: #A0A0A0; /* Match border color or make distinct */
    /* font-weight: bold; */ /* Make selected tab text bold */
}

/* Style the Tab Bar itself (Optional) */
QTabWidget::pane {
    border: 2px solid #A0A0A0;
    border-top: none; /* Pane border s below tabs */
    background-color: #FFFFFF; /* Content area background */
}

QTabBar {
    /* Remove the line often drawn above the tabs */
    border: none;

}

</string>
