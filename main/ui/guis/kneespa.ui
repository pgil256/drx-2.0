  <property name="styleSheet">
   <string notr="true">/* General Styles */
* {
    background-color: white;
    font-family: 'Arial', sans-serif;
    font-size: 14px;
}

/* Main Window and Central Widget */
QWidget#MainWindow, QWidget#central_widget {
    background-color: white;
}

/* Frame Styles */
QFrame#frameTop, QFrame#frame, QGroupBox#frameBottom {
    background-color: rgb(30, 30, 30);
    color: white;
    border: none;
    text-align: center;
    text-decoration: none;
    font-size: 14px;
    font-weight: bold;
}

QFrame#frame_3 {
	border:none;
}

/* Layout Styles */
QVBoxLayout#verticalLayout_3 {
    background-color: white;
    border: 1px solid red;
    border-radius: 45px;
    padding: 14px;
}

QGridLayout#gridLayout_2 {
    border: none;
    padding: 20px;
}

QHBoxLayout#horizontalLayout_19 {
    background-color: rgb(200, 0, 0);
    color: white;
    border: none;
    text-decoration: bold;
    font-size: 32px;
    font-weight: bold;
    border-radius: 12px;
}

QVBoxLayout#verticalLayout_20, QVBoxLayout#verticalLayout_21 {
    border-bottom: 1px solid #bdc3c7;
    padding: 2px;
    background-color: #ecf0f1;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    font-size: 18px;
}

/* Button Styles */
QPushButton#push_button_start {
        background-color: rgb(0, 200, 0);
        color: white;
        border: none;
        text-decoration: bold;
        font-size: 32px;
        font-weight: bold;
        border-radius: 12px;
}

QPushButton#login_button, QPushButton#setup_button, QPushButton#protocols_button, QPushButton#help_button {
    background-color: rgb(30, 30, 30);
    color: white;
    border: none;
    text-align: center;
    text-decoration: none;
    font-size: 22px;
    font-weight: bold;
    margin: 4px 2px;
    border-radius: 12px;
}

QPushButton#reset_arduino_setup_button, QPushButton#axial_flexion_position_go_button, QPushButton#axial_flexion_position_stop_button {
    outline: 0;
    border: 2px solid rgb(0,57,138);
	 font-size:16x;
    border-radius: 6px;
    background-color: #78909C;
    color: white;
}

QPushButton:hover:!pressed {
    background-color: #54d777;
}

QPushButton:hover:pressed {
    background-color: yellow;
    border: 2px solid red;
}

QPushButton:disabled {
    background-color: purple;
}

QPushButton:!enabled {
    background-color: white;
    color: black;
}

QPushButton:enabled {
    background-color: grey;
    color: white;
}

/* Request Status Change Button */
QPushButton#request_status_change {
    background-color: #3498db;  /* Bright blue - primary action */
    color: white;
    border: none;
    padding: 12px 20px;
    font-size: 16px;
    font-weight: bold;
    border-radius: 8px;
    min-width: 250px;
    min-height: 50px;
    text-align: center;
    margin: 5px;
}

QPushButton#request_status_change:hover {
    background-color: #2980b9;  /* Darker blue on hover */
}

QPushButton#request_status_change:pressed {
    background-color: #2472a4;  /* Even darker when pressed */
}

/* Request Assistance Button */
QPushButton#request_assistance {
    background-color: #3498db;  /* Bright blue - primary action */
    color: white;
    border: none;
    padding: 12px 20px;
    font-size: 16px;
    font-weight: bold;
    border-radius: 8px;
    min-width: 250px;
    min-height: 50px;
    text-align: center;
    margin: 5px;
}

QPushButton#request_pin_reset:hover {
    background-color: #2472a4;  /* Even darker when pressed */
}

QPushButton#request_pin_reset:pressed {
    background-color: #219a52;  /* Even darker when pressed */
}

/* Exit App Button */
QPushButton#exit_app_button {
    background-color: #e74c3c;  /* Red - warning/danger action */
    color: white;
    border: none;
    padding: 12px 20px;
    font-size: 16px;
    font-weight: bold;
    border-radius: 8px;
    min-width: 250px;
    min-height: 50px;
    text-align: center;
    margin: 5px;
}

QPushButton#exit_app_button:hover {
    background-color: #c0392b;  /* Darker red on hover */
}

QPushButton#exit_app_button:pressed {
    background-color: #a93226;  /* Even darker when pressed */
}

/* Disabled State for All Buttons */
QPushButton#request_status_change:disabled,
QPushButton#request_pin_reset:disabled,
QPushButton#exit_app_button:disabled {
    background-color: #bdc3c7;  /* Gray when disabled */
    color: #7f8c8d;
    cursor: not-allowed;
}

/* Focus State for All Buttons */
QPushButton#request_status_change:focus,
QPushButton#request_pin_reset:focus,
QPushButton#exit_app_button:focus {
    outline: none;
}


/* Label Styles */
QLabel#video_player_button {
    background-color: white;
    border: 1px solid red;
    border-radius: 45px;
    padding: 14px;
}

QLabel#measuredLocationlabel_4, QLabel#measuredWeightlabel_4 {
    font-size: 16px;
    padding: 2px;
}

QLabel#emergency_stop_setup_label {
    background-color: rgb(200, 0, 0);
    color: white;
    border: none;
    text-decoration: bold;
    font-size:30px;
    font-weight: bold;
    border-radius: 12px;
}

/* Slider Styles */
QSlider#axial_flexion_position_slider, QSlider#axial_flexion_pressure_slider {
    QSlider::groove:horizontal {
        border-radius: 2px;
        background-color: rgb(52, 59, 72);
    }
    QSlider::groove:horizontal:hover {
        background-color: blue;
    }
    QSlider::handle:horizontal {
        background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(0, 50, 145, 255), stop:1 rgba(255, 255, 255, 255));
        border: 4px solid black;
        width: 40px;
        margin: -44px 0px;
        border-radius: 14px;
    }
}

/* Group Box Styles */
QGroupBox {
    font: bold;
    border: 0px solid silver;
    border-radius: 6px;
    margin-top: 0px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 7px;
    padding: 0px 5px 0px 5px;
}

/* Transparent Backgrounds */
QGroupBox#groupBox_31, QVBoxLayout#verticalLayout_5, QLabel#axialFlexionPositionSliderlabel_3 {
    background: transparent;
}

/* Top Navigation Styles */
QLabel#top_nav_logo, QLabel#top_nav_brand_label, QLabel#username_nav {
    background-color: rgb(30, 30, 30);
    color: white;
    border: none;
    text-align: center;
    text-decoration: none;
    margin: 4px 30px;
}

QLabel#top_nav_brand_label {
    font-size: 40px;
    font-weight: bold;
}

QLabel#username_nav {
    font-size: 20px;
    font-weight: bold;
    border-radius: 12px;
}

/* Profile Button */
QLabel#profile_button {
    background-color: white;
    border: 1px solid black;
    margin: 0px 30px 0px 20px;
    border-radius: 40px;
    padding: 12px;
}

/* Page Styles */
QWidget#page_setup {
    font-size: 16px;
    padding: 2px;
}

QWidget#page_main, QTabWidget#DRx_tabs, QWidget#preset_protocols_tab {
    background-color: white;
    border: none;
    font-size: 22px;
}

/* Preset Protocols Tab Styles */
QVBoxLayout#verticalLayout_4, QVBoxLayout#verticalLayout_6 {
    border: none;
    padding: 15px;
    margin-top: 10px;
}

QGroupBox#groupBox_3, QGroupBox#groupBox_14, QGroupBox#groupBox_15 {
    padding: 10px 15px;
    margin-top: 10px;
}

QHBoxLayout#horizontalLayout_3, QHBoxLayout#horizontalLayout_11, QHBoxLayout#horizontalLayout_12 {
    font-size: 32px;
    font-weight: bold;
    margin: 5px 0px;
    border-bottom: 1px solid #bdc3c7;
    padding: 2px;
    background-color: #ecf0f1;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
}

QLabel#label_protocol_image {
	border:1px solid black;
}
QLabel#label_5, QLabel#backward_button_protocol_image, QLabel#forward_button_protocol_image,
QLabel#label_12 {
    font-size: 24px;
    font-weight: bold;
}

QLabel#time_label, QLabel#max_pressure_label, QLabel#max_left_label, QLabel#max_right_label {
    color: #2c3e50;
    font: bold 20px;
    padding: 5px 0px;
}

QSpinBox#time_edit {
    background-color: white;
    border: 1px solid rgb(52, 152, 219);
    border-radius: 4px;
    padding: 5px;
    min-width: 100px;
    min-height: 30px;
    font: 18px;
    color: #2c3e50;
}

QSpinBox#time_edit::up-button, QSpinBox#time_edit::down-button {
    width: 40px;
}


QSpinBox#max_pressure_edit, QSpinBox#max_left_edit, QSpinBox#max_right_edit {
    background-color: white;
    border: 1px solid rgb(52, 152, 219);
    border-radius: 4px;
    padding: 5px;
    min-width: 80px;
    min-height: 30px;
    font: 18px;
    color: #2c3e50;
}

QSpinBox#max_pressure_edit::up-button, QSpinBox#max_left_edit::up-button, QSpinBox#max_right_edit::up-button,
QSpinBox#max_pressure_edit::down-button, QSpinBox#max_left_edit::down-button, QSpinBox#max_right_edit::down-button {
    width: 40px;
}


QCheckBox#checkbox_no_pulse, QCheckBox#checkbox_intermittent_pulse, QCheckBox#checkbox_pulse_at_max {
    font: bold 18px;
    color: #2c3e50;
    spacing: 8px;
}

QCheckBox#checkbox_use_pulse::indicator {
    width: 26px;
    height: 26px;
    border: 2px solid rgb(52, 152, 219);
    border-radius: 4px;
    background-color: white;
}

QCheckBox#checkbox_use_pulse::indicator:checked {
    background-color: rgb(52, 152, 219);
}

QCheckBox#checkbox_use_pulse::indicator:hover {
    border-color: rgb(41, 128, 185);
}

QGroupBox#groupBox_15 {
    margin-top: 10px;
    padding-top: 10px;
}

/* Input Field Styles */
QLineEdit#protocol_number_field, QLineEdit#pressure_field {
    font-size: 22px;
    background-color: white;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 4px;
    color: #34495e;
    min-width: 60px;
}

/* CheckBox Styles */
QCheckBox {
    spacing: 10px;
    font-size: 24px;
    font-weight: bold;
}

QCheckBox::indicator {
    width: 24px;
    height: 24px;
}

/* Profile Page Styles */
QWidget#profile_page, QGroupBox#groupBox, QGroupBox#groupBox_4,
QGroupBox#groupBox_5, QGroupBox#groupBox_7, QGroupBox#groupBox_13, QGroupBox#groupBox_12, QGroupBox#groupBox_10 {
    border: none;
}

QGroupBox#groupBox_4 {
    font-size: 14px;
    font-weight: bold;
    color: #333333;
    border: 2px solid #3498db;
    border-radius: 8px;
    margin-top: 1ex;
    padding: 0px 2px;
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #f0f9ff, stop: 1 #e6f3ff);
}

QLabel#label_4, QLabel#username_label, QLabel#username_field,
QLabel#email_label, QLabel#status_label {
    border: none;
    padding: 0 5px;
    color: #2c3e50;
    font-size: 20px;
    font-weight: bold;
}

QPushButton#pushButton {
    background-color: #3498db;
    color: white;
    border: none;
    font-size: 22px;
    padding: 3px 9px;
    border-radius: 4px;
    font-weight: bold;
}

/* Help Page Styles */
QWidget#help_page, QGroupBox#groupBox_11, QGroupBox#groupBox_18 {
    color: #333333;
    background-color: #ffffff;
    border: none;
    padding: 10px;
}

QLabel#label_14 {
    border: none;
    padding: 0 10px;
    color: #3498db;
    font-weight: bold;
    font-size: 32px;
}

QPlainTextEdit#help_text_edit {
    border: none;
    font-size: 18px;
    padding: 30px;
    color: black;
    background-color: white;
    line-height: 2;
    border-left: 4px solid #3498db;
    margin-left: 20px;
}

/* Additional Button Styles */
QPushButton#measure_weight_button, QPushButton#measure_location_button {
    border-bottom: 1px solid #bdc3c7;
    padding: 2px;
    background-color: #ecf0f1;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    font-size: 18px;
}

QPushButton#axial_flexion_pressure_go_button, QPushButton#axial_flexion_pressure_stop_button,
QPushButton#lateral_flexion_position_go_button, QPushButton#lateral_flexion_position_stop_button,
QPushButton#horizontal_flexion_position_go_button, QPushButton#horizontal_flexion_position_stop_button {
    outline: none;
    border: 2px solid #00398A;  /* Using hex for consistency */
    border-radius: 6px;
    background-color: #78909C;
    color: white;
    padding: 8px 16px;  /* Added padding for better clickable area */
    font-weight: 500;   /* Slightly bolder text */
}
/* Label Styles for Flexion */
QLabel#lateral_flexion_position_label, QLabel#axial_flexion_position_label, QLabel#axial_flexion_pressure_label, QLabel#axial_flexion_position_label_2,
QLabel#lateral_flexion_position_label, QLabel#horizontal_flexion_position_label {
    font-size: 22px;
    background-color: white;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 4px;
    color: #34495e;
    min-width: 60px;
}

/* Table Widget Styles */
QTableWidget#patient_table_widget, QTableWidget#patient_table_widget_2 {
    background-color: #ffffff;
    padding: 10px 30px 0px 30px;
    alternate-background-color: #f7f7f7;
    border-radius: 4px;
    gridline-color: #e0e0e0;
}

QTableWidget::item {
    width: 200px;
}

QTableWidget::item:selected {
    background-color: #e6f3ff;
    color: #000000;
}

QHeaderView::section {
    background-color: rgb(85, 170, 255);
    color: white;
    padding: 10px;
    width: 300px;
    border: 1px solid #e0e0e0;
    font-weight: bold;
}</string>
