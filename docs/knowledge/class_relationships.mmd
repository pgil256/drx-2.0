        +run()
        +stop()
        +protocol_1()
        +protocol_2()
        +protocol_3()
        +set_to_angle(degrees: float)
        +set_to_pressure(pressure: int)
    }
    
    class Configuration {
        +AMarks: Dict[str, int]
        +BMarks: Dict[str, int]
