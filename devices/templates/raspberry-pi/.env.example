# Device-local login and support settings. Copy to .env only when provisioning.
# Generate salted PIN hashes using SecureAuthHelper; do not commit real values.
ADMIN_PIN_HASH=
ADMIN_USERNAME=Administrator
USER_PIN_HASH=
USER_USERNAME=User
KNEESPA_SMTP_USERNAME=
KNEESPA_SMTP_PASSWORD=
KNEESPA_ASSISTANCE_EMAIL=
KNEESPA_TICKET_EMAIL=
# Release signatures (development/docs/release-signing.md): warn (default)
# installs a release whose signature is missing or bad, with a warning;
# enforce refuses it. Switch to enforce only once the cloud signs releases
# and the release keyring is installed.
KNEESPA_RELEASE_SIGNATURE_MODE=warn
