# Unique cloud credentials for THIS physical device; never share across devices.
KNEESPA_CLOUD_URL=
KNEESPA_DEVICE_ID=
KNEESPA_DEVICE_TOKEN=
# Optional override; defaults to KNEESPA_CLOUD_URL + /patients/new.
# Public HTTPS page only, without credentials, query parameters, or patient details.
KNEESPA_PATIENT_PORTAL_URL=
